{
  "name": "amecc-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "serve:api": "node server/index.js",
    "drive-sync:bundle": "node scripts/build-drive-sync-parser.js",
    "db:restore:d1": "node scripts/restore-d1-backup.js",
    "db:import:supabase": "node scripts/migrate-sqlite-to-supabase.js",
    "user:create": "node scripts/create_user.js",
    "db:migrate:local": "wrangler d1 migrations apply amecc-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply amecc-db --remote"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "postgres": "^3.4.9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
